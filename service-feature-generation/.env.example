# Copy to .env to override locally (loaded automatically if you use
# `uvicorn --env-file .env`; otherwise export these in your shell/host
# environment). All settings are prefixed FEATURE_API_ -- see app/config.py.

# Comma-separated list of frontend origins allowed to call this API via
# CORS. Defaults already cover the Vite dev server (localhost:5173) and
# the deployed GitHub Pages frontend (bellarose77.github.io), so this is
# only needed to add another origin (a different dev port, a fork's own
# Pages URL, a custom domain).
FEATURE_API_CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://bellarose77.github.io

# Where to read the batch pipeline's feature artifact from. Defaults to
# <repo>/data/processed -- only needed to point at a different path, e.g.
# a mounted volume in a container (see ../Dockerfile).
# FEATURE_API_PROCESSED_DIR=/srv/data/processed
