# Copy to .env.local to override (Vite loads .env.local automatically and
# it's gitignored via *.local). Restart `npm run dev` after changing it.

# Base URL of the ELASTIQ pricing API (service-pricing-optimization).
# Used by "Load live data" (Data page) and the live "grid" technique path.
#
# In dev mode (`npm run dev`) this already defaults to
# http://127.0.0.1:8000 with no setup -- you only need this file to
# point at a different port or a remote instance.
#
# In a production build (`npm run build`, including CI/GitHub Pages) there
# is NO default: leave this unset to ship a build with no live pricing API
# configured (the app falls back to client-side computation / the bundled
# demo snapshot everywhere), or set it to a real, reachable HTTPS URL for
# that deployment before building.
VITE_PRICING_API_BASE_URL=http://127.0.0.1:8000

# Base URL of the ELASTIQ feature generation API (service-feature-generation).
# Used by the "Live market evidence" panel on a selected item (SKU detail page).
#
# In dev mode (`npm run dev`) this already defaults to
# http://127.0.0.1:8002 with no setup -- you only need this file to
# point at a different port or a remote instance.
#
# In a production build there is NO default: leave this unset to ship a
# build with no live feature API configured (the evidence panel simply
# doesn't load), or set it to a real, reachable HTTPS URL for that
# deployment before building.
VITE_FEATURE_API_BASE_URL=http://127.0.0.1:8002
